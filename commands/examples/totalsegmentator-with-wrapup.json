{
  "name": "totalsegmentator-ct",
  "label": "TotalSegmentator (upstream image + seg-wrapup)",
  "description": "Upstream TotalSegmentator on a DICOM scan; seg-wrapup adds the volumetrics report, label files and DICOM SEG",
  "version": "2.18.0",
  "schema-version": "1.0",
  "info-url": "https://github.com/wasserth/TotalSegmentator",
  "type": "docker",
  "image": "wasserth/totalsegmentator:2.18.0",
  "runtime": "nvidia",
  "limit-memory": 16384,
  "override-entrypoint": true,
  "command-line": "TotalSegmentator -i /input -o /output/segmentation.nii.gz --ml --statistics --task #TASK# && python -c \"import json,sys; from totalsegmentator.map_to_binary import class_map; json.dump({str(k): v for k, v in class_map[sys.argv[1]].items()}, open('/output/labels.json', 'w'))\" #TASK# && cp -r /input /output/.source_dicom",
  "environment-variables": {
    "SEG_MODEL_NAME": "TotalSegmentator",
    "SEG_MODEL_VERSION": "2.18.0",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
    "SEG_PROJECT": "#PROJECT_ID#",
    "SEG_SESSION_ID": "#SESSION_ID#",
    "SEG_SCAN_ID": "#SCAN_ID#"
  },
  "mounts": [
    {
      "name": "input-mount",
      "writable": false,
      "path": "/input"
    },
    {
      "name": "output-mount",
      "writable": true,
      "path": "/output"
    }
  ],
  "inputs": [
    {
      "name": "task",
      "label": "Task",
      "description": "TotalSegmentator task (total, total_mr, lung_vessels, ...)",
      "type": "string",
      "default-value": "total",
      "required": true,
      "replacement-key": "#TASK#"
    },
    {
      "name": "project-id",
      "description": "XNAT project ID (derived)",
      "type": "string",
      "required": true,
      "user-settable": false,
      "replacement-key": "#PROJECT_ID#"
    },
    {
      "name": "session-id",
      "description": "XNAT session ID (derived)",
      "type": "string",
      "required": true,
      "user-settable": false,
      "replacement-key": "#SESSION_ID#"
    },
    {
      "name": "scan-id",
      "description": "Scan ID (derived)",
      "type": "string",
      "required": true,
      "user-settable": false,
      "replacement-key": "#SCAN_ID#"
    }
  ],
  "outputs": [
    {
      "name": "segmentation",
      "description": "Label map, statistics.json, labels.json and the copied source series for the wrapup",
      "mount": "output-mount",
      "required": true
    }
  ],
  "xnat": [
    {
      "name": "totalsegmentator-ct-scan",
      "label": "TotalSegmentator on scan (DICOM)",
      "description": "Run TotalSegmentator on a scan's DICOM resource; output lands on the scan as TOTALSEG",
      "contexts": [
        "xnat:imageScanData"
      ],
      "external-inputs": [
        {
          "name": "scan",
          "description": "Scan with a DICOM resource",
          "type": "Scan",
          "required": true,
          "matcher": "'DICOM' in @.resources[*].label",
          "load-children": true
        }
      ],
      "derived-inputs": [
        {
          "name": "scan-dicom",
          "description": "The DICOM resource on the scan",
          "type": "Resource",
          "required": true,
          "derived-from-wrapper-input": "scan",
          "provides-files-for-command-mount": "input-mount",
          "matcher": "@.label == 'DICOM'",
          "load-children": true,
          "multiple": false
        },
        {
          "name": "session",
          "type": "Session",
          "required": true,
          "user-settable": false,
          "load-children": true,
          "derived-from-wrapper-input": "scan",
          "multiple": false
        },
        {
          "name": "project",
          "type": "Project",
          "required": true,
          "user-settable": false,
          "load-children": true,
          "derived-from-wrapper-input": "session",
          "multiple": false
        },
        {
          "name": "project-id",
          "type": "string",
          "required": true,
          "user-settable": false,
          "provides-value-for-command-input": "project-id",
          "derived-from-wrapper-input": "project",
          "derived-from-xnat-object-property": "id",
          "multiple": false
        },
        {
          "name": "session-id",
          "type": "string",
          "required": true,
          "user-settable": false,
          "provides-value-for-command-input": "session-id",
          "derived-from-wrapper-input": "session",
          "derived-from-xnat-object-property": "id",
          "multiple": false
        },
        {
          "name": "scan-id",
          "type": "string",
          "required": true,
          "user-settable": false,
          "provides-value-for-command-input": "scan-id",
          "derived-from-wrapper-input": "scan",
          "derived-from-xnat-object-property": "id",
          "multiple": false
        }
      ],
      "output-handlers": [
        {
          "name": "seg-resource",
          "accepts-command-output": "segmentation",
          "via-wrapup-command": "xnatworks/seg-wrapup:0.2.0",
          "as-a-child-of": "scan",
          "type": "Resource",
          "label": "TOTALSEG"
        }
      ]
    }
  ]
}
